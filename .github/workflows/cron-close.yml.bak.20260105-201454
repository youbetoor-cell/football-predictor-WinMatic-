name: cron-close
on:
  schedule:
    - cron: "*/10 * * * *"
  workflow_dispatch: {}

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - name: Call cron snapshots (close capture)
        env:
          BASE_URL: ${{ secrets.BASE_URL }}
          ADMIN_TOKEN: ${{ secrets.ADMIN_TOKEN }}
        run: |
          set -euo pipefail
          url="${BASE_URL}/cron/snapshots?admin_token=${ADMIN_TOKEN}&days_ahead=1&odds_limit=10&close_snapshot_minutes=180"
          echo "Calling: $url"
          resp="$(curl -fsS --max-time 120 "$url")"
          echo "Body:"
          echo "$resp"
          echo "$resp" | python3 -c 'import sys,json; o=json.load(sys.stdin); bad=[r for r in o.get("results",[]) if not r.get("ok")]; print("OK leagues:", o.get("leagues")) if not bad else (_ for _ in ()).throw(SystemExit("Some leagues failed: "+str(bad[:3])))'

set -euo pipefail
url="${BASE_URL}/cron/snapshots?admin_token=${ADMIN_TOKEN}&days_ahead=1&odds_limit=5"
echo "Calling: $url"
resp="$(curl -fsS --max-time 180 "$url")"
echo "Body:"
echo "$resp"
echo "$resp" | python3 - <<'PY'
import sys, json
o=json.load(sys.stdin)
bad=[r for r in o.get("results",[]) if not r.get("ok")]
if bad:
    raise SystemExit("Some leagues failed: "+str(bad[:3]))
print("OK leagues:", o.get("leagues"))
PY

